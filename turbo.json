{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["NEXT_PUBLIC_DATA_SOURCE", "NEXT_PUBLIC_API_URL", "DEMO_SESSION_SECRET"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {},
    "test": {
      "outputs": ["coverage/**"]
    },
    "web#test": {
      "outputs": ["coverage/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/docs/coverage.md",
        "$TURBO_ROOT$/docs/product-spec/**",
        "$TURBO_ROOT$/docs/specs/platform-admin.md",
        "$TURBO_ROOT$/docs/specs/settings-users-access.md",
        "$TURBO_ROOT$/packages/shared/src/**",
        "$TURBO_ROOT$/packages/shared/test/**",
        "$TURBO_ROOT$/apps/api/test/**"
      ]
    },
    "@workspace/shared#test": {
      "outputs": ["coverage/**"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/docs/FEATURES.md"]
    },
    "test:api": {
      "cache": false,
      "passThroughEnv": [
        "CONTROL_DATABASE_URL",
        "TENANT_DB_ADMIN_URL",
        "CONNECTION_ENCRYPTION_KEY",
        "DB_PROVIDER",
        "WHOLE_CHECK",
        "MONEY_SEEDS",
        "MONEY_STEPS",
        "MONEY_SEED"
      ]
    }
  }
}
