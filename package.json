{
  "name": "flooring-platform",
  "private": true,
  "packageManager": "pnpm@10.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=web",
    "dev:api": "pnpm --filter api dev",
    "build": "turbo run build",
    "lint": "turbo run lint && prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && pnpm test:hooks",
    "test:hooks": "node --test \".claude/hooks/*.test.mjs\"",
    "test:api": "turbo run test:api --concurrency=1",
    "start": "pnpm --filter web start",
    "test:e2e": "pnpm --filter web test:e2e",
    "test:e2e:smoke": "pnpm --filter web test:e2e:smoke",
    "db:generate": "pnpm --filter @workspace/db generate",
    "db:migrate": "pnpm --filter @workspace/db migrate",
    "db:seed": "pnpm --filter @workspace/db seed",
    "db:provision-tenant": "pnpm --filter @workspace/db provision-tenant",
    "fixtures": "pnpm --filter @workspace/shared fixtures",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1"
  }
}
