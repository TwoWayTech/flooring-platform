{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsup --watch --onSuccess \"node --env-file-if-exists=../../.env --enable-source-maps dist/main.js\"",
    "build": "tsup",
    "start": "node --enable-source-maps dist/main.js",
    "test": "vitest run --project unit",
    "test:api": "vitest run --project integration",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1167.0",
    "@aws-sdk/s3-request-presigner": "3.1167.0",
    "@nestjs/common": "12.4.2",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.4.2",
    "@nestjs/platform-express": "12.4.2",
    "@nestjs/swagger": "12.1.1",
    "@workspace/db": "workspace:*",
    "@workspace/providers": "workspace:*",
    "@workspace/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "postgres": "4.1.1",
    "reflect-metadata": "0.2.2",
    "resend": "6.38.0",
    "rxjs": "7.8.2",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.4.2",
    "@swc/core": "1.16.22",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "supertest": "7.3.2",
    "tsup": "9.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.0"
  }
}
